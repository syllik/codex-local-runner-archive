{
  "name": "runner-foundation",
  "version": "1.0.0",
  "description": "Local zero-touch orchestrator for Codex CLI agents.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "24.21.0"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "runner": "tsx src/cli/main.ts",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.6",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
